    "dataModelSchema": {
      "data": {
        "weather": {
          "current": {
            "temperatureText": {
              "type": "string",
              "description": "可直接显示的当前温度文本，已包含“℃”单位；展示时不得再次追加温度单位。例如“29℃”。",
              "sampleValue": "29℃"
            },
            "condition": {
              "type": "string",
              "description": "当前天气现象，例如“阴”“多云”“小雨”。",
              "sampleValue": "多云"
            }
          },
          "location": {
            "cityCode": {
              "type": "string",
              "description": "城市代码，如60814代表青浦区",
              "sampleValue": "60814"
            }
          }
        },
        "time": {
          "currentDate": {
            "type": "string",
            "description": "格式化的当前公历日期（年-月-日），例如 '2026-07-09'。",
            "sampleValue": "示例"
          },
          "dayOfWeek": {
            "type": "string",
            "description": "中文的星期描述，例如 '星期四'。",
            "sampleValue": "示例"
          }
        }
      }
    },
